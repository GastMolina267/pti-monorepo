# ─────────────────────────────────────────────────────────────
# Vitalia — variables de entorno (copiar a .env; nunca commitear .env)
# Validadas al arrancar la API en apps/api/src/config/env.schema.ts
# ─────────────────────────────────────────────────────────────

# --- API (NestJS) ---
NODE_ENV=development
APP_VERSION=0.1.0
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
SWAGGER_ENABLED=true

# --- PostgreSQL 16 (docker-compose) ---
POSTGRES_USER=vitalia
POSTGRES_PASSWORD=vitalia
POSTGRES_DB=vitalia
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vitalia:vitalia@localhost:5432/vitalia?schema=public

# --- MQTT (Eclipse Mosquitto) ---
MQTT_PORT=1883
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Seguridad ---
# Clave AES-256 compartida con los wearables (64 hex = 32 bytes). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEMETRY_AES_KEY=
# Secreto JWT para el login del personal (mínimo 32 caracteres)
JWT_SECRET=
