# ─────────────────────────────────────────────────────────────
# Vitalia — variables de entorno (copiar a .env; nunca commitear .env)
# Validadas al arrancar la API en apps/api/src/config/env.schema.ts
# ─────────────────────────────────────────────────────────────

# --- API (NestJS) ---
NODE_ENV=development
APP_VERSION=0.2.0
# Puerto de la API. No uses PORT: el dev-server de Angular lo toma y Backoffice/TV
# intentarían levantar en el 3000 (Nx carga este .env en todas las tareas).
API_PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:4300,http://localhost:5173
SWAGGER_ENABLED=true
HOSPITAL_TIMEZONE=America/Argentina/Cordoba
# Minutos promedio por consulta (estimación de espera para el paciente)
AVG_CONSULT_MINUTES=12

# --- PostgreSQL 16 (docker-compose) ---
POSTGRES_USER=vitalia
POSTGRES_PASSWORD=vitalia
POSTGRES_DB=vitalia
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vitalia:vitalia@localhost:5432/vitalia
# Log de queries SQL de TypeORM
DB_LOGGING=false
# Aplicar migraciones pendientes al arrancar la API (útil en el gateway/Docker)
DB_RUN_MIGRATIONS=false
# Base para el test de integración (se BORRA en cada corrida). Crear con:
#   docker compose exec postgres createdb -U vitalia vitalia_test
TEST_DATABASE_URL=postgresql://vitalia:vitalia@localhost:5432/vitalia_test

# --- MQTT (Eclipse Mosquitto) ---
MQTT_PORT=1883
# Broker de la API (ingesta de telemetría y comandos al OLED). Vacío: telemetría deshabilitada
# (la API sigue sirviendo turnos y /api/health responde "degraded").
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Seguridad ---
# Clave AES-256 compartida con los wearables (64 hex = 32 bytes). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEMETRY_AES_KEY=
# Secreto JWT para el login del personal (mínimo 32 caracteres). Valor SOLO para desarrollo:
JWT_SECRET=dev-vitalia-cambiar-este-secreto-en-produccion-2026
# Duración del token en segundos (8 h)
JWT_EXPIRES_IN_SECONDS=28800

# --- Fase 5: operación de largo plazo ---
# Detrás de un proxy (Nginx del gateway): número de saltos. Vacío en desarrollo.
TRUST_PROXY=
# Horas que se conservan las lecturas de telemetría (0 = no borrar) y cada cuánto se limpia.
TELEMETRY_RETENTION_HOURS=72
TELEMETRY_RETENTION_INTERVAL_MINUTES=60
# Réplica a la nube (RF-O6). Vacío = deshabilitada. Para probar: pnpm cloud:sink
GATEWAY_ID=gateway-local
CLOUD_SYNC_URL=
CLOUD_SYNC_TOKEN=
CLOUD_SYNC_INTERVAL_SECONDS=15

# --- Seed de desarrollo ---
# Contraseña de los usuarios sembrados (por defecto: Vitalia2026!)
SEED_PASSWORD=
