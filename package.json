{
  "name": "@vitalia/source",
  "version": "0.2.0",
  "description": "Vitalia — Ecosistema Digital Hospitalario (PTI UBP): monorepo Nx con API NestJS y Backoffice Angular",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "nx run-many -t serve -p api backoffice tv-display",
    "dev:api": "nx serve api",
    "dev:backoffice": "nx serve backoffice",
    "dev:tv": "nx serve tv-display",
    "fw:build": "nx run wearable-firmware-poc:pio-build",
    "fw:upload": "nx run wearable-firmware-poc:pio-upload",
    "fw:monitor": "nx run wearable-firmware-poc:pio-monitor",
    "fw:codegen": "tsx tools/scripts/gen-firmware-headers.ts",
    "fw:test": "nx run wearable-firmware-poc:pio-test",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "check": "nx run-many -t lint test build && nx format:check",
    "affected": "nx affected -t lint test build",
    "format": "nx format:write",
    "graph": "nx graph",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "nx run api:db-migrate",
    "db:generate": "nx run api:db-generate",
    "db:revert": "nx run api:db-revert",
    "db:show": "nx run api:db-show",
    "db:seed": "nx run api:db-seed",
    "db:reset": "nx run api:db-reset",
    "ai:sync": "node tools/scripts/sync-ai-skills.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs,html,scss,css,json,md,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.1",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/material": "~22.2.1",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lucide/angular": "^1.51.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "~7.8.0",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@analogjs/vitest-angular": "2.6.3",
    "@angular-devkit/core": "22.1.6",
    "@angular-devkit/schematics": "22.1.6",
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@angular/language-service": "22.1.4",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "23.2.0",
    "@nx/devkit": "23.2.0",
    "@nx/docker": "23.2.0",
    "@nx/esbuild": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/jest": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/nest": "23.2.0",
    "@nx/node": "23.2.0",
    "@nx/vite": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@nx/web": "23.2.0",
    "@nx/webpack": "23.2.0",
    "@nx/workspace": "23.2.0",
    "@oxc-project/runtime": "^0.115.0",
    "@schematics/angular": "22.1.6",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "22.2.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.6.0",
    "nx": "23.2.0",
    "prettier": "^3.8.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "8.0.9",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "~4.1.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  }
}
