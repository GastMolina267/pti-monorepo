{
  "name": "wearable-firmware-poc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/wearable-firmware-poc/src",
  "projectType": "application",
  "tags": ["scope:wearable", "type:app"],
  "implicitDependencies": ["contracts"],
  "// targets": "PlatformIO (pio) tiene que estar en el PATH. Sin caché: secrets.h no se versiona y Nx no lo puede hashear.",
  "targets": {
    "pio-check-docker": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker build --progress=plain -f apps/wearable-firmware-poc/Dockerfile.check --target check -t vitalia-firmware-check:local ."
      }
    },
    "pio-toolchain-docker": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker build --progress=plain -f apps/wearable-firmware-poc/Dockerfile.check --target toolchain -t vitalia-firmware-toolchain:local ."
      }
    },
    "pio-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/wearable-firmware-poc",
        "command": "pio run"
      }
    },
    "pio-upload": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/wearable-firmware-poc",
        "command": "pio run -t upload"
      }
    },
    "pio-monitor": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "cwd": "apps/wearable-firmware-poc",
        "command": "pio device monitor"
      }
    },
    "pio-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/wearable-firmware-poc",
        "command": "pio test -e native"
      }
    },
    "pio-test-device": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/wearable-firmware-poc",
        "command": "pio test -e esp32-c3-supermini"
      }
    },
    "pio-clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/wearable-firmware-poc",
        "command": "pio run -t clean"
      }
    }
  }
}
