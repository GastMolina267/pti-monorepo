#pragma once
/**
 * Plantilla de configuración por dispositivo. Copiar como `secrets.h` y completar.
 *
 *   cp src/secrets.h.example src/secrets.h
 *
 * `secrets.h` esta en .gitignore: NUNCA se versiona (AGENTS.md 5 y 8).
 * Es por pulsera: numero fisico, credenciales MQTT y clave AES se cargan a mano al flashear.
 */

// --- Identidad (ADR 0011) ---
// Numero fisico de la pulsera (etiqueta), 1-99. El codigo queda wb-<NN>-<ultimos 3 bytes de la MAC>,
// ej. wb-01-24d7cc. Tiene que coincidir con wearables.code en la base del gateway.
#define WEARABLE_NUMBER 1

// --- Wi-Fi (Hito 6a) ---
// Solo 2.4 GHz: el ESP32-C3 no tiene 5 GHz.
#define WIFI_SSID  "TU_SSID_2G"
#define WIFI_PASS  "TU_PASSWORD"

// --- Hora (ts en ms de TelemetryReading) ---
// DESARROLLO: red unica con internet -> NTP publico.
// PRODUCCION: la VLAN 10 no tiene internet -> NTP local del RUT956 / gateway (pendiente, ver roadmap Fase 4).
#define NTP_SERVER "pool.ntp.org"

// --- MQTT (Hito 6b) ---
#define MQTT_BROKER "192.168.0.100"   // IP del Edge Gateway (Mosquitto); en desarrollo, la notebook con `pnpm infra:up`
#define MQTT_PORT   1883              // VLAN 10 solo permite este puerto
#define MQTT_SALA   "sala1"           // segmento <sala> del topico
// Vacios = acceso anonimo (Mosquitto de desarrollo). Fase 4: usuario = codigo del wearable,
// contraseña generada con mosquitto_passwd en el gateway y copiada aca a mano.
#define MQTT_USER   ""
#define MQTT_PASS   ""

// --- Cifrado (Hito 7, ADR 0006) ---
// Mismo valor que TELEMETRY_AES_KEY del .env del gateway: 64 caracteres hex (32 bytes).
// Nunca imprimirla por serie ni escribirla en otro archivo.
#define TELEMETRY_AES_KEY_HEX ""
